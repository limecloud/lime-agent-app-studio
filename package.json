{
  "name": "@limecloud/agent-app-studio",
  "version": "0.1.2",
  "description": "Lime Agent App Studio CLI and visual publisher for Agent App packages.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "bin": {
    "lime-agent-app-studio": "bin/lime-agent-app-studio.mjs",
    "lime-agent-app": "bin/lime-agent-app-studio.mjs"
  },
  "files": [
    "bin",
    "src",
    "app",
    "dist",
    "scripts",
    "APP.md",
    "app.capabilities.yaml",
    "docs/v1/README.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-agent-app.mjs",
    "validate:app": "node src/cli.mjs project inspect --app-dir .",
    "test": "node --test tests/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --access public --dry-run",
    "publish:npm": "npm publish --access public",
    "dev": "node src/server.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "yazl": "^3.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
